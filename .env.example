# Copy to .env. Anything left blank runs in a labelled demo mode.

ANTHROPIC_API_KEY=
# BILLBACK_MODEL_SMART=claude-sonnet-5-5
# BILLBACK_MODEL_FAST=claude-haiku-5-5

# Capital One Nessie: log in with GitHub at nessieisreal.com, copy key from profile.
# Then run: uv run python scripts/seed_nessie.py
NESSIE_API_KEY=

# Bright Data: zones from the control panel (Web Unlocker + SERP API)
BRIGHTDATA_API_KEY=
# e.g. agent_unlocker / agent_serp. Search needs the SERP zone; the Unlocker zone can't do Google.
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=

# Cartesia: key from play.cartesia.ai/keys. Then run scripts/setup_cartesia.py and paste the ids here.
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
CARTESIA_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b
CARTESIA_WEBHOOK_SECRET=pick-a-long-random-string
CARTESIA_TOOL_TOKEN=pick-another-long-random-string
# The teammate playing hospital billing (US number, E.164)
REP_PHONE_NUMBER=

# Public https URL of this server (cloudflared/ngrok). Needed for Cartesia webhooks + phone links.
PUBLIC_BASE_URL=http://localhost:8000

# Tiger Data (Timescale Postgres): household profiles + bank history over time, sorted by need on /households.html.
# Tiger Cloud connection string (postgres://tsdbadmin:...@....tsdb.cloud.timescale.com:.../tsdb?sslmode=require).
# Blank: nothing is stored there; cases run from data/cases/ as before.
TIGER_DATABASE_URL=

# Admin key (16+ chars) for approve, reset, start/call/ask and other paid actions. Open the app once with
# ?key=<this> and the browser keeps it. Unset: those actions only work from http://localhost on this machine.
BILLBACK_ADMIN_TOKEN=
# Judging mode: 1 = refuse to start unless Claude, Bright Data, Nessie and the admin key are set, and never
# use the sample policies. Leave off for offline development and tests.
BILLBACK_REQUIRE_LIVE=

# Twilio phone pipeline (Twilio audio <-> Cartesia STT/TTS <-> Claude call brain). See docs/voice.md.
# Trial accounts can only call verified numbers: verify REP_PHONE_NUMBER (and PATIENT_PHONE_NUMBER).
# PUBLIC_BASE_URL must be https so Twilio can reach /voice/twilio/* (e.g. cloudflared tunnel --url http://localhost:8000).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: TwiML App (Voice URL https://<host>/voice/twilio/agent, POST) enables the 3-way patient-authorization conference
TWILIO_TWIML_APP_SID=
# Optional: the patient's phone for verbal authorization at the start of the call
PATIENT_PHONE_NUMBER=
# CARTESIA_STT_MODEL=ink-2
# CARTESIA_TTS_MODEL=sonic-3.6
