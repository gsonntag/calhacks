# Copy to .env. Anything left blank runs in a labelled demo mode.

ANTHROPIC_API_KEY=
# BILLBACK_MODEL_SMART=claude-sonnet-5-5
# BILLBACK_MODEL_FAST=claude-haiku-5-5

# Capital One Nessie: log in with GitHub at nessieisreal.com, copy key from profile.
# Then run: uv run python scripts/seed_nessie.py
NESSIE_API_KEY=

# Bright Data: zones from the control panel (Web Unlocker + SERP API)
BRIGHTDATA_API_KEY=
# e.g. agent_unlocker / agent_serp. Search needs the SERP zone; the Unlocker zone can't do Google.
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=

# Cartesia: key from play.cartesia.ai/keys. Then run scripts/setup_cartesia.py and paste the ids here.
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
CARTESIA_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b
CARTESIA_WEBHOOK_SECRET=pick-a-long-random-string
CARTESIA_TOOL_TOKEN=pick-another-long-random-string
# The teammate playing hospital billing (US number, E.164)
REP_PHONE_NUMBER=

# Public https URL of this server (cloudflared/ngrok). Needed for Cartesia webhooks + phone links.
PUBLIC_BASE_URL=http://localhost:8000
